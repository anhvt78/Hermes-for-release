{
  "agent_id": "tech_product-agent-3",
  "version": "1.0.0",
  "role_type": "worker",
  "reports_to": "tech_product-lead-agent",
  "cluster": "tech_product",
  "status": "sandbox",
  "lifecycle_stage": "design",
  "objective": {
    "primary_goal": "Phân tích nghiệp vụ: chuyển yêu cầu khách hàng thành đặc tả rõ ràng, kiểm tra được",
    "primary_goal_en": "Business Analyst: translate customer requirements into clear, testable specifications",
    "north_star_kpi_ref": "kpi_req_rework"
  },
  "kpis": [
    {
      "id": "kpi_req_rework",
      "metric": "requirements_rework_pct",
      "target_operator": "<=",
      "target_value": 20,
      "unit": "percent",
      "frequency": "weekly"
    },
    {
      "id": "kpi_req_first_pass",
      "metric": "requirements_accepted_first_pass_pct",
      "target_operator": ">=",
      "target_value": 80,
      "unit": "percent",
      "frequency": "weekly"
    },
    {
      "id": "kpi_spec_delivered",
      "metric": "analysis_docs_delivered_per_sprint",
      "target_operator": ">=",
      "target_value": 2,
      "unit": "count",
      "frequency": "weekly"
    }
  ],
  "io_contract": {
    "accepts_event_topics": [
      "order.completed",
      "meeting.decision_recorded",
      "lead.qualified"
    ],
    "emits_event_topics": [
      "meeting.convene_requested",
      "report.okr_weekly_update"
    ]
  },
  "tools": [
    {
      "name": "write_file",
      "scope": "write:analysis_docs — thay cho công cụ chưa có thật «process_mapping_tool»",
      "write_access": true
    },
    {
      "name": "terminal",
      "scope": "read_only:customer_and_order_data — thay cho công cụ chưa có thật «database_query»",
      "write_access": false
    }
  ],
  "authority": {
    "auto_approve_max_vnd": 500000,
    "requires_human_approval_above_vnd": 5000000,
    "forbidden_actions": [
      "approve_requirement_change_without_lead_signoff",
      "use_real_customer_data_outside_approved_scope"
    ]
  },
  "escalation_rules": [
    {
      "condition": "requirement_conflict_between_departments",
      "action": "request_lead_facilitation",
      "target_agent_or_human": "tech_product-lead-agent",
      "max_response_time_seconds": 1800
    },
    {
      "condition": "ambiguous_or_missing_business_input",
      "action": "raise_clarification_request",
      "target_agent_or_human": "tech_product-lead-agent",
      "max_response_time_seconds": 3600
    },
    {
      "condition": "requirement_touches_legal_or_compliance_constraint",
      "action": "escalate_for_review",
      "target_agent_or_human": "chu_tich",
      "max_response_time_seconds": 3600
    }
  ],
  "sandbox_mode": "non_main",
  "risk_tier_default": "T1",
  "reviewer_model_diversity_required": false,
  "_note": "Bổ sung 15/09/2026: vị trí này do Genesis tạo ở bước D0.5 nhưng trước đây CHƯA có thẻ vai trò, nên màn Cơ chế vận hành để trống 4 cột (leo thang / hạn mức tự quyết / ngưỡng xin ý kiến / KPI). Thẻ này bổ sung cho đúng vị trí thật, KHÔNG thay đổi 11 thẻ cũ."
}
