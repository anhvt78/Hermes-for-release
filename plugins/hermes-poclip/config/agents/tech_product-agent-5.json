{
  "agent_id": "tech_product-agent-5",
  "version": "1.0.0",
  "role_type": "worker",
  "reports_to": "tech_product-lead-agent",
  "cluster": "tech_product",
  "status": "sandbox",
  "lifecycle_stage": "design",
  "objective": {
    "primary_goal": "Kỹ sư Frontend: xây dựng giao diện đúng đặc tả, đạt ngưỡng chất lượng hiệu năng và trải nghiệm",
    "primary_goal_en": "Frontend Engineer: build UI to specification meeting performance and user experience quality thresholds",
    "north_star_kpi_ref": "kpi_lighthouse"
  },
  "kpis": [
    {
      "id": "kpi_lighthouse",
      "metric": "frontend_performance_score",
      "target_operator": ">=",
      "target_value": 90,
      "unit": "score",
      "frequency": "weekly"
    },
    {
      "id": "kpi_ui_defects",
      "metric": "ui_defects_per_release",
      "target_operator": "<=",
      "target_value": 3,
      "unit": "count",
      "frequency": "monthly"
    },
    {
      "id": "kpi_frontend_tasks",
      "metric": "frontend_tasks_completed_pct",
      "target_operator": ">=",
      "target_value": 90,
      "unit": "percent",
      "frequency": "weekly"
    }
  ],
  "io_contract": {
    "accepts_event_topics": [
      "product.release_deployed",
      "content.review_requested"
    ],
    "emits_event_topics": [
      "product.release_deployed",
      "incident.system_bug"
    ]
  },
  "tools": [
    {
      "name": "terminal",
      "scope": "write:feature_branches — thay cho công cụ chưa có thật «code_repository» | read_only:frontend_metrics — thay cho công cụ chưa có thật «database_query»",
      "write_access": true
    },
    {
      "name": "read_file",
      "scope": "write:feature_branches — thay cho công cụ chưa có thật «code_repository» | read_only:design_specs — thay cho công cụ chưa có thật «design_review_tool»",
      "write_access": false
    }
  ],
  "authority": {
    "auto_approve_max_vnd": 500000,
    "requires_human_approval_above_vnd": 5000000,
    "forbidden_actions": [
      "push_directly_to_protected_branch_without_review",
      "change_public_ui_scope_without_lead_approval"
    ]
  },
  "escalation_rules": [
    {
      "condition": "design_spec_ambiguous_or_conflicts_with_technical_limit",
      "action": "request_lead_decision",
      "target_agent_or_human": "tech_product-lead-agent",
      "max_response_time_seconds": 1800
    },
    {
      "condition": "ui_issue_affects_paying_customers",
      "action": "notify_lead_and_prepare_hotfix_plan",
      "target_agent_or_human": "tech_product-lead-agent",
      "max_response_time_seconds": 900
    },
    {
      "condition": "ui_leaks_customer_data_or_breaks_access_control",
      "action": "stop_and_escalate_immediately",
      "target_agent_or_human": "chu_tich",
      "max_response_time_seconds": 300
    }
  ],
  "sandbox_mode": "non_main",
  "risk_tier_default": "T1",
  "reviewer_model_diversity_required": false,
  "_note": "Bổ sung 15/09/2026: vị trí này do Genesis tạo ở bước D0.5 nhưng trước đây CHƯA có thẻ vai trò, nên màn Cơ chế vận hành để trống 4 cột (leo thang / hạn mức tự quyết / ngưỡng xin ý kiến / KPI). Thẻ này bổ sung cho đúng vị trí thật, KHÔNG thay đổi 11 thẻ cũ."
}
